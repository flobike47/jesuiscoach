# À copier en .env.prod sur la Pi, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Images (par défaut : tags locaux. Mets le chemin de ton registry si push/pull)
BFF_IMAGE=jesuiscoach-bff:latest
WEB_IMAGE=jesuiscoach-web:latest

# Origin du frontend (CORS) — séparé par virgules si plusieurs
CORS_ORIGIN=https://coach.tondomaine.com
# Adresse publique de l'app, BASE_PATH compris (lien des notifications push).
# Optionnelle si l'app est servie à la racine de la première origine CORS.
APP_URL=

# --- Conteneur web (runtime, injectés au boot) ---
# Sous-chemin où l'app est servie. "/" si à la racine du domaine, ou par ex.
# "/jesuiscoach/" si servi via reverse proxy sur https://tondomaine.com/jesuiscoach/
BASE_PATH=/
BFF_URL=https://api-coach.tondomaine.com

# --- Postgres (conteneur de la stack) ---
# Lettres et chiffres uniquement (placé dans une URL). Générer :
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD= # ⚠️ secret
# Dossier hôte des sauvegardes quotidiennes, idéalement sur un autre disque
# (sinon volume Docker postgres-backups, sur le même disque que la base).
BACKUP_DIR=/mnt/ssd/backups/jesuiscoach

# Adresse publique du BFF (callback OAuth Intervals.icu, webhooks)
PUBLIC_API_URL=https://api-coach.tondomaine.com
# Mode démo : équipe fictive, aucun appel Intervals.icu. false en prod.
DEMO_MODE=false
# Synchro des nouvelles sorties (minutes, 10 minimum). 30 = 48 lectures/athlète/jour,
# sous le quota Intervals.icu de 100 requêtes/athlète/jour.
SYNC_INTERVAL_MIN=30

# Intervals.icu — app OAuth (https://intervals.icu/oauth/apply)
# Redirect URI à déclarer : https://api-coach.tondomaine.com/api/public/auth/intervals/callback
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET= # ⚠️ secret
# IDs Intervals des coachs (ex. i123456), séparés par des virgules
COACH_ATHLETE_IDS=
# Clé AES-256 des jetons Intervals (32 octets base64) — ⚠️ secret, ne jamais la changer
# sans reconnecter tous les comptes.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Notifications push (nouvelles sorties, alertes) — optionnel.
# Générer une paire une seule fois : npx web-push generate-vapid-keys
# ⚠️ Changer de paire invalide les abonnements : chaque appareil devra réactiver.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= # ⚠️ secret
VAPID_SUBJECT=mailto:toi@exemple.com
