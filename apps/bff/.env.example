# BFF runtime
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Adresse publique de l'app (liens des notifications, retour OAuth). Optionnelle :
# par défaut la première origine de CORS_ORIGIN, app servie à la racine.
APP_URL=
# Adresse publique de ce BFF (callback OAuth Intervals.icu + webhooks)
PUBLIC_API_URL=http://localhost:4000

# Mode démo : 10 cyclistes fictifs, aucun appel à Intervals.icu
DEMO_MODE=true
# Synchro des sorties (minutes, 10 minimum). 30 = 48 lectures/athlète/jour (quota 100).
SYNC_INTERVAL_MIN=30

# Redis et Postgres de dev (npm run db:up)
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgres://jesuiscoach:jesuiscoach@localhost:5433/jesuiscoach

# Intervals.icu — app OAuth (https://intervals.icu/oauth/apply puis Settings → Apps → Manage App)
# Redirect URI à déclarer : <PUBLIC_API_URL>/api/public/auth/intervals/callback
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=                        # ⚠️ confidentiel
# Secret des webhooks (Manage App) ; URL à déclarer : <PUBLIC_API_URL>/api/public/webhooks/intervals
INTERVALS_WEBHOOK_SECRET=                       # ⚠️ confidentiel
# Wahoo (phase E, optionnel) : redirect <PUBLIC_API_URL>/api/public/devices/wahoo/callback,
# webhook <PUBLIC_API_URL>/api/public/webhooks/wahoo. Sans ces valeurs, Wahoo reste désactivé.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=                            # ⚠️ confidentiel
WAHOO_WEBHOOK_TOKEN=                            # ⚠️ confidentiel
# IDs Intervals des coachs (ex. i123456), séparés par des virgules
COACH_ATHLETE_IDS=
# Clé AES-256 qui chiffre les jetons Intervals en base (32 octets base64)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=                           # ⚠️ confidentiel

# Notifications push — optionnel. Sans ces trois variables, la fonctionnalité est désactivée.
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                              # ⚠️ confidentiel
VAPID_SUBJECT=mailto:toi@exemple.com
